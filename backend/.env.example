# Copier ce fichier en .env dans le dossier de déploiement du VPS
# Ne jamais committer le .env réel (il est dans .gitignore)

# ── Image Docker ───────────────────────────────────────────────────────────────
# Owner du dépôt GitHub (tel quel, sensible à la casse)
GHCR_OWNER=BenKL404

# ── API Secrets ────────────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 48
JWT_SECRET=remplacer-par-un-secret-de-48-caracteres-minimum

# ── Mode de fonctionnement ─────────────────────────────────────────────────────
OTP_DEV_MODE=false
OKLIFOR_VERIFICATION_DEMO_APPROVE=false

# ── MinIO (object storage) ─────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 24
MINIO_ROOT_USER=oklifor
MINIO_ROOT_PASSWORD=remplacer-par-un-mot-de-passe-minio

# ── Optionnel ──────────────────────────────────────────────────────────────────
# FIREBASE_ENABLED=false
# SERVER_PORT=8100
