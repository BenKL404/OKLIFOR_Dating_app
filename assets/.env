# Oklifor — configuration locale (chargée au démarrage de l’app).
# Ne mets pas de secrets ici si tu publies l’APK/IPA (préfère --dart-define pour les clés sensibles).
# Doc complète : .env.example à la racine du dépôt.

# =============================================================================
# Téléphone RÉEL Android — Wi‑Fi (carte « Wi‑Fi » ipconfig : 10.179.40.193)
# Le téléphone doit être sur le même réseau Wi‑Fi que le PC. Pare-feu : TCP 8100.
# =============================================================================
OKLIFOR_API_BASE=http://10.97.113.193:8100

# USB à la place : commente la ligne du dessus et décommente + adb reverse tcp:8100 tcp:8100
# OKLIFOR_API_BASE=http://127.0.0.1:8100

# Émulateur / desktop : commente OKLIFOR_API_BASE pour reprendre les défauts (10.0.2.2 / 127.0.0.1).
# =============================================================================

# Démo / debug (optionnel, pour usage futur dans l’app)
# OKLIFOR_LOG_API=false
