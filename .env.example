# Fichier exemple pour variables d'environnement production
# Copier en .env et remplir sur VPS / GitHub Secrets

# GitHub Container Registry (ton username GitHub)
GHCR_OWNER=ton_username_github

# API
JWT_SECRET=votre_secret_jwt_tres_long_et_securise
OTP_DEV_MODE=false
OKLIFOR_VERIFICATION_DEMO_APPROVE=false

# MinIO (S3 compatible)
MINIO_ROOT_USER=oklifor
MINIO_ROOT_PASSWORD=votre_mot_de_passe_minio_securise

# GitHub Secrets à créer :
# VPS_SSH_USER (ex: deploy)
# VPS_SSH_KEY (clé privée SSH VPS)
# JWT_SECRET
# MINIO_ROOT_USER
# MINIO_ROOT_PASSWORD
