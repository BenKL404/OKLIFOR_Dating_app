# =============================================================================
# Oklifor — variables d’environnement (référence)
# =============================================================================
# L’app Flutter charge surtout : assets/.env (copie ce fichier comme base si tu veux).
# Les clés ci-dessous documentent aussi le backend Spring (à exporter manuellement
# ou via ton IDE / Docker — Spring ne lit pas ce fichier automatiquement).
# =============================================================================

# --- Flutter (assets/.env) ---------------------------------------------------
# Priorité réelle : dart-define > assets/.env > défaut par plateforme (port 8100 par défaut backend).

# URL API sans slash final.
# Téléphone réel Android : obligatoire (pas 10.0.2.2). Ex. Wi‑Fi :
# OKLIFOR_API_BASE=http://192.168.1.47:8100
# USB : adb reverse tcp:8100 tcp:8100 puis http://127.0.0.1:8100
# Émulateur seulement, sans ligne : défaut 10.0.2.2:8100
OKLIFOR_API_BASE=

# Équivalent en ligne de commande (écrase .env) :
#   flutter run --dart-define=OKLIFOR_API_BASE=http://192.168.1.10:8100

# --- Backend Spring (export / IDE / Docker) ---------------------------------
# SERVER_PORT=8100
# MONGODB_URI=mongodb://localhost:27017/oklifor
# REDIS_HOST=localhost
# REDIS_PORT=6379
# JWT_SECRET=remplace-par-une-chaine-32-caracteres-minimum
# OTP_DEV_MODE=true

# Firebase Admin (SMS + POST /api/v1/auth/firebase)
# FIREBASE_ENABLED=false
# GOOGLE_APPLICATION_CREDENTIALS=C:\chemin\vers\serviceAccount.json
# FIREBASE_CREDENTIALS_JSON_PATH=

# Fichiers uploadés (profil, vérif identité) — ne pas versionner ces dossiers
# OKLIFOR_PROFILE_MEDIA_UPLOAD_DIR=data/profile-media
# OKLIFOR_VERIFICATION_UPLOAD_DIR=data/verification-uploads
#& "$env:LOCALAPPDATA\Android\Sdk\platform-tools\adb.exe" start-server
#taskkill /F /IM emulator.exe /IM qemu-system-x86_64.exe /IM netsimd.exe /IM adb.exe